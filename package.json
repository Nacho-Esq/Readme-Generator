{
  "name": "cai-readme-generator",
  "displayName": "CAI Readme-Generator",
  "description": "Genera README en español a partir de un repositorio local usando Azure OpenAI Responses API y una plantilla Markdown con tokens propios.",
  "version": "1.0.0",
  "publisher": "nttdata",
  "license": "MIT",
  "engines": {
    "vscode": "^1.92.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "readmeGeneratorAi.generateReadme",
        "title": "Generate README",
        "category": "CAI Readme-Generator",
        "icon": "$(book)"
      },
      {
        "command": "readmeGeneratorAi.updateReadme",
        "title": "Update README",
        "category": "CAI Readme-Generator",
        "icon": "$(sync)"
      },
      {
        "command": "readmeGeneratorAi.openLastTrace",
        "title": "Open Last Trace",
        "category": "CAI Readme-Generator",
        "icon": "$(output)"
      },
      {
        "command": "readmeGeneratorAi.openGeneratedData",
        "title": "Open Generated Data",
        "category": "CAI Readme-Generator",
        "icon": "$(database)"
      },
      {
        "command": "readmeGeneratorAi.setApiKey",
        "title": "Configurar API key",
        "category": "CAI Readme-Generator",
        "icon": "$(key)"
      },
      {
        "command": "readmeGeneratorAi.setEndpoint",
        "title": "Configurar endpoint",
        "category": "CAI Readme-Generator",
        "icon": "$(globe)"
      },
      {
        "command": "readmeGeneratorAi.clearCredentials",
        "title": "Borrar credenciales guardadas",
        "category": "CAI Readme-Generator",
        "icon": "$(trash)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "readmeGeneratorAi.generateReadme"
        },
        {
          "command": "readmeGeneratorAi.updateReadme"
        },
        {
          "command": "readmeGeneratorAi.openLastTrace"
        },
        {
          "command": "readmeGeneratorAi.openGeneratedData"
        },
        {
          "command": "readmeGeneratorAi.setApiKey"
        },
        {
          "command": "readmeGeneratorAi.setEndpoint"
        },
        {
          "command": "readmeGeneratorAi.clearCredentials"
        }
      ],
      "explorer/title": [
        {
          "command": "readmeGeneratorAi.generateReadme",
          "group": "navigation"
        },
        {
          "command": "readmeGeneratorAi.updateReadme",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "CAI Readme-Generator",
      "properties": {
        "readmeGeneratorAi.deployment": {
          "type": "string",
          "default": "",
          "markdownDescription": "Nombre del deployment (modelo) principal de Azure OpenAI que usa la Responses API. Configúralo con el nombre exacto de tu recurso.",
          "scope": "machine"
        },
        "readmeGeneratorAi.preSelectionDeployment": {
          "type": "string",
          "default": "",
          "markdownDescription": "Nombre del deployment del modelo ligero que lee y ordena todos los archivos del repositorio. Si se deja vacío, se usa el mismo deployment que el modelo principal.",
          "scope": "machine"
        },
        "readmeGeneratorAi.templatePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Ruta absoluta (opcional) a una plantilla Markdown externa (formato de tokens `[[ ruta | M/H/A | tipo | instrucción ]]`). Si se deja vacío, se usa la plantilla incluida en la extensión.",
          "scope": "resource"
        },
        "readmeGeneratorAi.readDepth": {
          "type": "string",
          "default": "básico",
          "enum": [
            "básico",
            "detallado",
            "profundo",
            "personalizado"
          ],
          "enumDescriptions": [
            "Consumo bajo: aprox. 30k tokens de lectura detallada.",
            "Consumo medio: aprox. 90k tokens de lectura detallada.",
            "Consumo elevado: aprox. 180k tokens de lectura detallada.",
            "Presupuesto definido manualmente en el ajuste readDepthCustomBudget."
          ],
          "markdownDescription": "Controla el presupuesto de tokens del modelo principal al leer los archivos seleccionados. Los tokens consumidos por el modelo ligero de pre-seleccion son independientes y no se cuentan aqui.",
          "scope": "resource"
        },
        "readmeGeneratorAi.readDepthCustomBudget": {
          "type": "number",
          "default": 30000,
          "minimum": 1000,
          "markdownDescription": "Presupuesto personalizado de tokens para el modelo principal. Solo se aplica cuando `readmeGeneratorAi.readDepth` está configurado como `personalizado`.",
          "scope": "resource"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/vscode": "^1.92.0",
    "@vscode/vsce": "^2.31.1",
    "typescript": "^5.5.4",
    "vitest": "^4.1.10"
  }
}
